extends SceneTree

func _initialize() -> void:
	var book := GameCatalog.new()
	DirAccess.make_dir_recursive_absolute("user://first_light_tests")
	var path := "user://first_light_tests/lyra_%d.json" % Time.get_ticks_usec()
	var store := ProgressStore.new(book, path)
	assert(book.data.heroes.size() == 4 and FrameLibrary.new().painted.portraits.ryn.adult_age == 27)
	assert(book.find_row("heroes", "lyra").age == 24 and book.category("lyra") == "spear")
	assert(not store.available_hero("lyra"))
	var p := store.profile.duplicate(true)
	p.cleared = [1, 2, 3]
	assert(store.commit(p) and store.change_hero("lyra"))
	assert(store.begin_run(1) and store.profile.pending.stats.hero == "lyra")
	assert(not store.change_hero("ryn"))
	assert(store.settle(store.profile.pending.id, false, 0))
	# Simulate a true three-hero v5 save, including every optional subsystem.
	assert(store.change_hero("eira"))
	p = store.profile.duplicate(true)
	Recruitment.ensure(store, p)
	p["evolution"] = HeroEvolution.fresh()
	p["training"] = AttributeTraining.fresh(book)
	p["outfits"] = Wardrobe.fresh()
	assert(store.commit(p) and store.begin_run(1))
	var legacy := store.profile.duplicate(true)
	legacy.version = 5
	legacy.heroes.erase("lyra")
	legacy.expansion.builds.erase("lyra")
	for field in ["training", "evolution", "outfits"]: legacy[field].erase("lyra")
	for field in ["fragments", "awakening"]: legacy.recruitment[field].erase("lyra")
	legacy.items = legacy.items.filter(func(item): return item.uid != "starter_lyra")
	var pending: Dictionary = legacy.pending.duplicate(true)
	var ryn: Dictionary = legacy.heroes.ryn.duplicate(true)
	var file := FileAccess.open(path + ".v5", FileAccess.WRITE)
	file.store_string(JSON.stringify(legacy, "", true, true))
	file.close()
	var original := FileAccess.get_file_as_bytes(path + ".v5")
	var migrated := ProgressStore.new(book, path + ".v5")
	assert(not migrated.read_only and migrated.profile.version == ProgressStore.VERSION)
	assert(migrated.profile.heroes.ryn == ryn and migrated.profile.pending == pending)
	assert(migrated.profile.heroes.lyra.level == 1 and migrated.profile.heroes.lyra.equipment.weapon == "")
	assert(migrated.profile.training.lyra.atk == 0 and migrated.profile.outfits.lyra == "original")
	assert(migrated.profile.recruitment.fragments.lyra == 0 and migrated.profile.recruitment.awakening.lyra == 1)
	migrated.fail_writes = true
	assert(not migrated.setting("speed", 2))
	assert(FileAccess.get_file_as_bytes(path + ".v5") == original)
	migrated.fail_writes = false
	assert(migrated.setting("speed", 2) and FileAccess.get_file_as_bytes(path + ".v5.bak") == original)
	assert(migrated.profile.pending == pending)
	print("PASS: Lyra is independent of Ryn; v5 migration preserves Ryn, pending, optional systems, failure safety and original backup")
	quit()
