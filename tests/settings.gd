extends SceneTree
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var catalog := GameCatalog.new()
	var dir := "user://first_light_tests/settings_%d" % Time.get_ticks_usec()
	DirAccess.make_dir_recursive_absolute(dir)
	var store := ProgressStore.new(catalog,dir.path_join("save.json"))
	var original := store.profile.duplicate(true)
	assert(GameOptions.state(original) == GameOptions.DEFAULTS)
	for invalid in [{"quality":"ultra"},{"fps_limit":120},{"lighting":1},{"ui_volume":-1},{"ui_volume":NAN}]:
		var p := original.duplicate(true)
		p.settings.merge(invalid,true)
		assert(not store.valid(p))
	assert(GameOptions.save(store,{"quality":"low","ui_volume":.25,"speed":2,"prioritize_heal":false},{"auto_ult":false,"auto_next":true}))
	assert(not Formation.state(store.profile,catalog).auto_ult)
	assert(ProgressStore.new(catalog,store.path).profile == store.profile)
	var saved := store.profile.duplicate(true)
	store.fail_writes = true
	assert(not GameOptions.save(store,{"quality":"high"}) and store.profile == saved)
	store.fail_writes = false
	var backup := dir.path_join("backup.json")
	assert(GameOptions.export_backup(store,backup))
	assert(GameOptions.read_backup(store,backup) == saved)
	assert(GameOptions.save(store,{"quality":"high"}))
	assert(GameOptions.restore_backup(store,GameOptions.read_backup(store,backup)))
	assert(store.profile == saved)
	var file := FileAccess.open(dir.path_join("bad.json"),FileAccess.WRITE)
	file.store_string("{broken")
	file.close()
	assert(GameOptions.read_backup(store,dir.path_join("bad.json")).is_empty())
	assert(store.begin_run(1))
	var pending: Dictionary = store.profile.pending.duplicate(true)
	assert(not pending.team.prioritize_heal)
	assert(not GameOptions.save(store,{"speed":1}))
	assert(not GameOptions.save(store,{}, {"auto_ult":true}))
	assert(not GameOptions.export_backup(store,backup))
	assert(not GameOptions.restore_backup(store,saved))
	assert(GameOptions.save(store,{"damage_numbers":false,"ui_volume":.5}))
	assert(store.profile.pending == pending)
	var model := TeamBattle.new(catalog)
	model.start(pending)
	assert(not model.prioritize_heal)
	var mira: Dictionary = model.allies[0].duplicate(true)
	mira.id = "mira"
	model.allies[0].hp = 1
	model._basic(mira)
	assert(mira.action.kind == "basic")
	model.prioritize_heal = true
	model._basic(mira)
	assert(mira.action.kind == "heal")
	pending.team.erase("prioritize_heal")
	model.start(pending)
	assert(model.prioritize_heal)
	pending.team.prioritize_heal = 1
	assert(not Formation.valid_snapshot(store,pending.team))
	store.read_only = true
	assert(not GameOptions.save(store,{"quality":"high"}))
	assert(not GameOptions.export_backup(store,backup))
	print("PASS: settings validation, old defaults, atomic writes, snapshot protection, backup roundtrip/corrupt rejection")
	quit()
