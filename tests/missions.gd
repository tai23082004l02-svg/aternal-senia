extends SceneTree
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var book := GameCatalog.new()
	var dir := "user://first_light_tests/missions_%d" % Time.get_ticks_usec()
	DirAccess.make_dir_recursive_absolute(dir)
	var store := ProgressStore.new(book, dir.path_join("save.json"))
	var old := store.profile.duplicate(true)
	assert(store.valid(old) and not old.has("missions"))
	assert(MissionBoard.ready_count(old) == 0 and store.profile == old)
	var monday := 1788134400 # 2026-08-31 UTC Monday
	assert(Time.get_datetime_string_from_unix_time(monday).begins_with("2026-08-31"))
	var p := old.duplicate(true)
	for event in ["offline", "wins", "kills", "enhance", "summon"]: MissionBoard.record(p, event, 100, monday)
	assert(store.commit(p))
	assert(MissionBoard.points(p.missions.daily, "daily") == 100)
	assert(MissionBoard.points(p.missions.weekly, "weekly") == 100)
	store.fail_writes = true
	assert(not MissionBoard.claim(store, "daily", "wins", 0, monday))
	assert(store.profile == p and ProgressStore.new(book, store.path).profile == p)
	store.fail_writes = false
	assert(MissionBoard.claim(store, "daily", "wins", 0, monday))
	assert(store.profile.missions.vip_exp == 5 and store.profile.gold == 60)
	assert(not MissionBoard.claim(store, "daily", "wins", 0, monday))
	assert(MissionBoard.claim(store, "daily", "", 100, monday))
	assert(store.profile.missions.vip_exp == 15)
	assert(not MissionBoard.claim(store, "daily", "", 100, monday))
	assert(MissionBoard.claim(store, "weekly", "wins", 0, monday))
	assert(store.profile.missions.vip_exp == 25)
	var saved := store.profile.duplicate(true)
	assert(ProgressStore.new(book, store.path).profile == saved)
	var reloaded := ProgressStore.new(book, store.path)
	assert(not MissionBoard.claim(reloaded, "daily", "", 100, monday))
	var next := MissionBoard.state(saved, monday + 86400)
	assert(next.daily.claimed.is_empty() and next.daily.counts.wins == 0)
	assert(next.weekly == saved.missions.weekly and next.vip_exp == 25)
	assert(MissionBoard.state(saved, monday - 86400) == saved.missions)
	var week := MissionBoard.state(saved, monday + 7 * 86400)
	assert(week.weekly.claimed.is_empty() and week.weekly.counts.wins == 0)
	assert(not MissionBoard.claim(store, "daily", "wins", 0, monday + 86400))
	assert(store.profile == saved)
	assert(store.begin_run(1))
	assert(not MissionBoard.claim(store, "weekly", "kills", 0, monday))
	assert(store.settle(store.profile.pending.id, true, 3))
	var once := store.profile.duplicate(true)
	assert(store.settle(once.settled[-1], true, 3) and store.profile == once)
	# Fresh transaction hooks count actual gameplay, independent of legacy totals.
	var fresh := ProgressStore.new(book, dir.path_join("events.json"))
	var funded := fresh.profile.duplicate(true)
	funded.gold = 5000
	funded.shards = 10
	funded.last_offline = MissionBoard.now() - 120
	assert(fresh.commit(funded))
	assert(fresh.claim_offline(MissionBoard.now()))
	assert(fresh.enhance("starter_eira"))
	assert(Recruitment.summon(fresh, 10))
	assert(fresh.begin_run(1))
	assert(fresh.settle(fresh.profile.pending.id, true, 3))
	var counts: Dictionary = fresh.profile.missions.daily.counts
	assert(counts.offline == 1 and counts.enhance == 1 and counts.summon == 1 and counts.wins == 1 and counts.kills == 3)
	assert(fresh.profile.missions.weekly.counts.summon == 10)
	print("PASS: mission events, atomic rewards/VIP EXP, no duplicate claims, UTC day/Monday reset, rollback and legacy saves")
	quit()
